# Header keamanan untuk Netlify & Cloudflare Pages.
# Ganti https://*.supabase.co dengan URL project Anda agar lebih ketat.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://challenges.cloudflare.com https://app.midtrans.com https://app.sandbox.midtrans.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://app.midtrans.com https://app.sandbox.midtrans.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://*.supabase.co https://*.midtrans.com; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://challenges.cloudflare.com https://app.midtrans.com https://app.sandbox.midtrans.com https://api.midtrans.com https://api.sandbox.midtrans.com; frame-src https://challenges.cloudflare.com https://app.midtrans.com https://app.sandbox.midtrans.com; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), geolocation=(self), microphone=(), payment=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains
/sw.js
  Cache-Control: no-cache
/vendor/*
  Cache-Control: public, max-age=31536000, immutable
